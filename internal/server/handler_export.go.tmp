// handler_export.go - 数据导出相关handlers
package server

import (
	"log"
	"log-processor/internal/models"
	"net/http"
	"path/filepath"
	"strconv"
	"time"

	"github.com/gin-gonic/gin"
)

// getExportFormats 获取支持的导出格式
func (s *Server) getExportFormats(c *gin.Context) {
	formats := s.exportManager.GetSupportedFormats()
	c.JSON(http.StatusOK, gin.H{"formats": formats})
}

// exportLogs 导出日志
func (s *Server) exportLogs(c *gin.Context) {
	var req models.ExportRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid request: " + err.Error()})
		return
	}

	if req.Format == "" {
		req.Format = "excel"
	}

	// 查询要导出的日志
	logs, err := s.storage.Query(req.Filter, 100000, 0)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to query logs: " + err.Error()})
		return
	}

	if len(logs) == 0 {
		c.JSON(http.StatusBadRequest, gin.H{"error": "no logs to export"})
		return
	}

	// 生成文件名
	fileName := req.FileName
	if fileName == "" {
		fileName = "logs_" + time.Now().Format("20060102_150405")
	}
	fileName += getExtension(req.Format)

	// 导出文件路径
	exportPath := filepath.Join("./exports", fileName)

	// 执行导出
	opts := &exporter.ExportOptions{
		TimeFormat: "2006-01-02 15:04:05",
	}
	if err := s.exportManager.Export(req.Format, logs, exportPath, opts); err != nil {
		log.Printf("[ERROR] Export failed: %v", err)
		c.JSON(http.StatusInternalServerError, gin.H{"error": "export failed: " + err.Error()})
		return
	}

	log.Printf("[INFO] Exported %d logs to %s", len(logs), exportPath)

	c.JSON(http.StatusOK, gin.H{
		"status":    "ok",
		"file_name": fileName,
		"file_path": exportPath,
		"count":     len(logs),
	})
}
