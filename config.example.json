{
  "server": {
    "host": "0.0.0.0",
    "port": 8080
  },
  "parser": {
    "format": "nginx"
  },
  "processor": {
    "worker_count": 50,
    "batch_size": 500,
    "batch_timeout": 5000,
    "overflow_enabled": true,
    "overflow_dir": "./data/overflow",
    "overflow_max_disk_mb": 512,
    "overflow_drain_batch": 1000,
    "overflow_drain_interval_ms": 200
  },
  "alert": {
    "slow_threshold": 1000,
    "error_rate_threshold": 5
  },
  "display": {
    "page_size": 50,
    "refresh_interval": 0,
    "columns": [
      "timestamp",
      "method",
      "path",
      "status_code",
      "response_time",
      "client_ip"
    ]
  },
  "import": {
    "concurrency": 1,
    "max_lines": 100000
  },
  "storage": {
    "type": "sqlite",
    "db_path": "./data/logs.db",
    "max_memory_items": 100000,
    "retention_hours": 168
  },
  "receiver": {
    "tcp_enabled": true,
    "tcp_port": 9000,
    "udp_enabled": true,
    "udp_port": 9001,
    "http_enabled": true,
    "http_port": 9002,
    "file_watcher_enabled": false,
    "max_connections": 1000,
    "buffer_size": 8192
  }
}